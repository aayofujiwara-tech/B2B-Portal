# Google Apps Script Webhook URL
# GASでウェブアプリとしてデプロイ後、生成されたURLをここに設定
# 例: https://script.google.com/macros/s/AKfycb.../exec
GAS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# --- NextAuth (管理画面Google認証) ---
# Google Cloud Console > OAuth 2.0 クライアントID で取得
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth用シークレット（openssl rand -base64 32 で生成）
NEXTAUTH_SECRET=your-nextauth-secret

# デプロイ先のURL（ローカル開発時は http://localhost:3000）
NEXTAUTH_URL=http://localhost:3000

# 管理画面へのアクセスを許可するメールドメイン（カンマ区切りで複数指定可）
# 例: company.com または company.com,partner.co.jp
ALLOWED_EMAIL_DOMAINS=company.com
